#!name=沃钱包凭证采集
#!desc=打开沃钱包（epay.10010.com）时自动抓取登录凭证。抓到后存本机，并推一条 Bark（凭证已放进剪贴板），粘到表1 A列即可。需开启 MITM。
#!author=
#!icon=creditcard.fill
#!version=1.0.0

[Script]
# script-path 换成你自己托管这个 js 的地址（GitHub raw / Gist 都行），
# 想本地调试就把文件名填成 wopay-token.js 并放进 Loon 的脚本目录
http-response ^https?://epay\.10010\.com/ script-path=https://raw.githubusercontent.com/CNL123/epay/refs/heads/main/wopay-token.js, requires-body=true, timeout=10, tag=沃钱包凭证采集, enable=true

[MITM]
hostname = %APPEND% epay.10010.com
